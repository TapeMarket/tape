# systemd unit for the relayer. Copy to /etc/systemd/system/, adjust the paths, then:
#   systemctl daemon-reload && systemctl enable --now tape-relayer
#   journalctl -u tape-relayer -f

[Unit]
Description=Tape relayer (orders, keeper, indexer, API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tape
WorkingDirectory=/opt/tape/relayer
# Secrets and settings live in /opt/tape/.env (mode 600, owned by the service user).
# Node 22 or newer: the Hyperliquid price stream uses Node's own WebSocket.
ExecStart=/usr/bin/node src/index.mjs
Restart=always
RestartSec=3

# Hardening. Two settings are deliberately absent:
#   MemoryDenyWriteExecute  kills node outright (V8 needs writable+executable pages for its JIT).
#   MemoryMax               node sizes its heap from it and then runs out at about half.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tape
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
