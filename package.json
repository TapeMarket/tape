{
  "name": "tape",
  "private": true,
  "description": "1000x synthetic perps on Ethereum, against a house that starts from zero",
  "scripts": {
    "test": "forge test",
    "test:fork": "FORK=true forge test --match-contract ForkTest -vv",
    "test:invariant": "FOUNDRY_INVARIANT_RUNS=200 FOUNDRY_INVARIANT_DEPTH=150 forge test --match-contract InvariantTest",
    "test:deployable": "node tools/deployable.mjs && DEPLOYABLE=true forge test",
    "deployable": "node tools/deployable.mjs",
    "test:relayer": "node tools/test-relayer.mjs",
    "test:books": "forge test --match-contract PreviewParity && node web/test/books.test.mjs",
    "test:smoke": "node relayer/test/smoke.mjs",
    "test:e2e": "node web/e2e/run.mjs",
    "test:preview": "node web/e2e/readiness.mjs",
    "test:deposits": "node --test web/test/deposits.test.mjs",
    "test:installer": "node --test tools/server-install.test.mjs",
    "test:frontend": "node --test web/test/deposits.test.mjs web/test/deposit-flow.test.mjs web/test/feed.test.mjs web/test/navigation.test.mjs web/test/trade-history.test.mjs web/test/day-reference.test.mjs web/test/performance-data.test.mjs",
    "test:preview:hyperliquid": "node web/e2e/hyperliquid.mjs",
    "test:stats": "node web/e2e/stats.mjs",
    "test:preview:daily-change": "node web/e2e/daily-change.mjs",
    "test:preview:reliability": "node web/e2e/reliability.mjs",
    "test:preview:portfolio": "node web/e2e/portfolio.mjs",
    "test:triggers": "node web/e2e/trigger-editor.mjs",
    "abi": "forge build && node tools/export-abi.mjs",
    "dev:chain": "anvil --port 8545",
    "dev:deploy": "node tools/deployable.mjs --forge && forge script script/DevDeploy.s.sol --rpc-url http://127.0.0.1:8545 --broadcast --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 && node tools/export-abi.mjs",
    "dev:relayer": "node relayer/src/index.mjs",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "deploy:site": "bash tools/deploy-site.sh",
    "test:live:core": "node web/e2e/live-core.mjs",
    "test:loading": "node web/e2e/loading.mjs",
    "test:deposit-ui": "node web/e2e/deposits.mjs",
    "test:withdraw-ui": "node web/e2e/withdrawals.mjs",
    "test:deposit-live": "node web/e2e/deposit-live.mjs",
    "test:performance": "node web/e2e/performance.mjs",
    "test:platform:pages": "node web/e2e/platform-pages.mjs",
    "test:docs": "node web/e2e/docs.mjs"
  }
}
