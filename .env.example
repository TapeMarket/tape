# Copy to .env and fill in. Never commit .env.

# --- Relayer ---------------------------------------------------------------------------------
# Chain the relayer serves, and how to reach it. Use a private RPC in production.
CHAIN_ID=1
RELAYER_RPC_URL=

# The operator hot key: submits trades and pays their gas. Give a file path, not the key itself.
# It must be registered with Exchange.setOperator and it can never move trader funds.
OPERATOR_KEY_FILE=

# The price signer's key: signs every price the exchange trades at. Give a file path, not the key.
# Its address must be the oracle's signer() (PRICE_SIGNER at deploy). Whoever holds this key sets
# the price: keep it on this machine only, in a file only the service can read. It needs no ETH.
PRICE_SIGNER_KEY_FILE=

# No price is signed while the book midpoint differs too far from the configured reference.
# The default reference is Hyperliquid's oracle, for every market (150 = 1.5%).
# This is one venue's cross-check, not an independent multi-venue median. 0 disables the band.
PRICE_REFERENCE=oracle
PRICE_SANITY_BPS=150
# Nor while Hyperliquid's own book is wider than this, bid to ask (100 = 1%).
PRICE_MAX_SPREAD_BPS=100

# Only for a deployment made with ORACLE=pyth: the Hermes key, entitled to every listed feed, and
# how much ETH to top the oracle's Pyth-fee float up by when it runs low (0 = only warn).
# PYTH_API_KEY=
# ORACLE_TOPUP_ETH=0.01

# How often stakers are paid, and the smallest amount worth the gas of paying them.
STAKER_PUSH_SECONDS=300
STAKER_PUSH_MIN_USD=25

PORT=8787
# Set to 1 when the relayer sits behind a reverse proxy, so limits apply per visitor.
TRUST_PROXY=1
# The site's origin: https://tapemarket.io
CORS_ORIGIN=https://tapemarket.io,https://www.tapemarket.io
# Persistent state: price logs, charts, names, referrals and pending trigger orders.
# DATA_DIR=/opt/tape/relayer/data

# --- Foundry (tests and deploys) ---------------------------------------------------------------
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# Fork tests replay historical Pyth updates and need old state.
ETH_ARCHIVE_RPC_URL=https://eth.drpc.org

# The feed: big wins and liquidations posted to Telegram and X (relayer/src/feed.mjs). Off unless set.
# FEED_TELEGRAM_TOKEN_FILE=/etc/tape/telegram.token
# FEED_TELEGRAM_CHAT=@tapemarket
# FEED_X_KEYS_FILE=/etc/tape/x-keys.json
# FEED_MIN_WIN_USD=250
# FEED_MIN_LIQ_USD=250000
# FEED_X_PER_DAY=15
# Weekly seasons: share of each week's fees paid to its top ten (out of the team's half).
# SEASON_PRIZE_BPS=1000
# Backup gas wallets: more operator keys (each an operator of the Exchange), used when the main one runs low.
# BACKUP_OPERATOR_KEY_FILES=/etc/tape/operator-2.key
# GAS_MIN_ETH=0.02
# FEED_ALERT_CHAT=<your own Telegram chat id, for low-gas alerts>
# The most one side of a market may hold: the floor plus this many times the vault's cash (0 switches it off).
# CASH_FLOOR_USD=2000000
# CASH_MULTIPLE=50
