# Response headers for the site on Cloudflare. tools/deploy-site.sh copies this to dist/_headers.
#
# The site may only talk to itself, the preview's price feed, and its relayer. If the relayer is
# somewhere other than api.tapemarket.io, the deploy script puts that origin in instead.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.hyperliquid.xyz wss://api.hyperliquid.xyz https://api.tapemarket.io; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
