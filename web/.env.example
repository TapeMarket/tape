# Where the relayer's API lives. The site talks to nothing else.
#
# Leave it unset in a production build and the site runs in preview mode instead: an exchange
# inside the browser tab with real prices, play money and simulated traders. That is what gets
# hosted until the contracts are live. Set it (at build time) to go live against the relayer.
VITE_API_URL=http://127.0.0.1:8787

# Only used by the built-in test wallet on a local chain.
VITE_RPC_URL=http://127.0.0.1:8545

# The name and the coin's ticker shown in preview mode. In live mode both come from the
# deployment: the name from the Exchange, the ticker from the coin's contract.
# VITE_BRAND=Tape
# VITE_COIN=TAPE
